# ─────────────────────────────────────────────────────────
# Production environment — fill these in before deploying
# ─────────────────────────────────────────────────────────

DEBUG=False
SECRET_KEY=replace-me-with-a-very-long-random-secret-key

# Set to your server's public IP or domain (comma-separated, no spaces)
ALLOWED_HOSTS=your-server-ip,yourdomain.com

# CORS — set to your app's origin (or leave blank to deny all external origins)
# CORS_ALLOWED_ORIGINS=https://yourdomain.com

# ─── Database (PostgreSQL) ─────────────────────────────────
DB_NAME=checkme_db
DB_USER=postgres
DB_PASSWORD=change-me-strong-password
DB_HOST=db
DB_PORT=5432
